# Amadeus API — get free credentials at https://developers.amadeus.com
AMADEUS_CLIENT_ID=your_client_id_here
AMADEUS_CLIENT_SECRET=your_client_secret_here

# SMTP for price-alert emails (e.g. Gmail, Mailgun, SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password

# Server
PORT=3001

# SQLite database path (optional, defaults to ./data/tracker.db)
# DB_PATH=./data/tracker.db
